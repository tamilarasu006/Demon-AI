[Unit]
Description=DEMON API Server
After=network.target

[Service]
Type=simple
User=DEMON
WorkingDirectory=/opt/DEMON
ExecStart=/opt/DEMON/.venv/bin/DEMON serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
Environment=HOME=/opt/DEMON
# Binding 0.0.0.0 requires authentication. This file MUST exist and contain:
#   DEMON_API_KEY=<key>      (generate one: `DEMON auth generate-key`)
# It is not prefixed with "-", so the unit fails to start if the file is
# missing — preventing an accidentally unauthenticated public server.
EnvironmentFile=/etc/DEMON/env

[Install]
WantedBy=multi-user.target
